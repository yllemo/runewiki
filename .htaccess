# .htaccess (rot)
#
# RuneWiki körs med index.php i webroten. Denna fil:
#  1. Blockerar direktåtkomst till källkod/innehåll/konfiguration.
#  2. Släpper igenom statiska assets (mallar) och uppladdad media direkt.
#  3. Skickar allt annat (snygga URL:er) till index.php för routing.

RewriteEngine On

# Neka direktåtkomst till interna mappar
RewriteRule ^(bin|config|content|core|data|plugins|skills)(/|$) - [F,L]

# Släpp igenom riktiga filer i templates/*/assets och images direkt
RewriteCond %{REQUEST_URI} ^/(templates/[^/]+/assets/|images/)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /chat/ och /admin/ har egna front controllers (chat/index.php,
# admin/index.php) och ska INTE routas genom wiki-routern i roten — låt
# Apache hantera dessa mappar normalt (DirectoryIndex kör respektive
# index.php). /admin/index.php gate:ar sig själv på inloggning.
RewriteRule ^(chat|admin)(/|$) - [L]

# Allt annat → index.php. OBS: ingen "!-d"-kontroll här — /images och
# /images/<namespace> är riktiga mappar på disk (kataloger med uppladdade
# filer), och skulle annars falla igenom till Apaches egen katalog-
# hantering (403 eller listning) istället för att nå appens router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]
